<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CVX.Client</AssemblyName>
    <RootNamespace>CVX.Client</RootNamespace>
    <Version>0.2.0</Version>
    <PackageId>CVX.Client</PackageId>
    <Authors>Sao</Authors>
    <Description>Client-side lifecycle, deployment, and callback receiver for the CVX integration.</Description>
    <PackageTags>wechat robot lifecycle windows</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/hk5jj7grw4-debug/CVX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hk5jj7grw4-debug/CVX.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>
