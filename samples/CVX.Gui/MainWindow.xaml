<Window x:Class="CVX.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CVX GUI Sample"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="微信机器人客户端" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="打开后自动连接内核。关闭只释放本客户端，不会停止微信。自动版本修复会关闭其他目录中的微信会话。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="AccountAvatar"
                             Width="40"
                             Height="40"
                             Margin="0,0,12,0"
                             Visibility="Collapsed"
                             Stroke="#2F3942"
                             StrokeThickness="1">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AccountAvatarBrush" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AccountText"
                                   FontWeight="SemiBold"
                                   Text="" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border x:Name="StatusDot"
                                    Width="10" Height="10" CornerRadius="5"
                                    Background="#8A97A3" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderStatusText"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}"
                                       Text="正在连接内核…" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="配置" />
                            <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,6" Text="组件服务 URL" />
                            <TextBox x:Name="UpdateServerBox" />
                            <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,6" Text="组件 Token" />
                            <PasswordBox x:Name="ComponentTokenBox" />
                            <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,6" Text="内核端口" />
                            <TextBox x:Name="GvxPortBox" Text="19088" />
                            <Button x:Name="SaveConfigButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="保存配置"
                                    Click="SaveConfigButton_Click"
                                    Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="首次运行请填写地址和 Token 后保存。已连接后修改将在下次启动生效。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="生命周期" />
                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <Button x:Name="StartButton"
                                        Content="重新接入"
                                        Click="StartButton_Click"
                                        Margin="0,0,6,0" />
                                <Button x:Name="RestartButton"
                                        Style="{StaticResource GhostButton}"
                                        Content="重启微信"
                                        Click="RestartButton_Click"
                                        Margin="6,0,0,0" />
                            </UniformGrid>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="连接异常时可重新接入。重启微信会中断当前会话。未登录不等于崩溃。版本修复可能关闭其它微信。" />
                            <TextBlock Style="{StaticResource LabelText}" Margin="0,14,0,6" Text="组件下载" />
                            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="DownloadProgressText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       Text="等待连接" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="运行状态" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource MutedText}" Text="阶段" />
                                <TextBlock x:Name="PhaseText" Grid.Column="1" Text="—" />

                                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="内核 API" />
                                <TextBlock x:Name="ApiReadyText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="—" />

                                <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="登录状态" />
                                <TextBlock x:Name="LoginStateText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="—" />

                                <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="GVx API" />
                                <TextBlock x:Name="GvxApiText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="—" />

                                <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="消息回调" />
                                <TextBlock x:Name="CallbackReadyText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Text="—" />

                                <TextBlock Grid.Row="5" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="组件版本" />
                                <TextBlock x:Name="ComponentVersionText" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="—" />

                                <TextBlock Grid.Row="6" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="目标微信" />
                                <TextBlock x:Name="RequiredWechatText" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="—" />

                                <TextBlock Grid.Row="7" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="检测微信" />
                                <TextBlock x:Name="DetectedWechatText" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Text="未知" />

                                <TextBlock Grid.Row="8" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="版本匹配" />
                                <TextBlock x:Name="VersionMatchText" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Text="未知" />

                                <TextBlock Grid.Row="9" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="最近检查" />
                                <TextBlock x:Name="CheckedAtText" Grid.Row="9" Grid.Column="1" Margin="0,8,0,0" Text="—" />

                                <TextBlock Grid.Row="10" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="最近错误" />
                                <TextBlock x:Name="LastErrorText" Grid.Row="10" Grid.Column="1" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Text="无" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="消息" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RefreshRoomsButton"
                                            Style="{StaticResource GhostButton}"
                                            Content="刷新群聊"
                                            Click="RefreshRoomsButton_Click"
                                            Padding="12,6"
                                            Margin="0,0,8,0" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="清空日志"
                                            Click="ClearLogButton_Click"
                                            Padding="12,6" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ListBox x:Name="MessageList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,0,0,8" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#232A31" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="send">
                                                        <Setter Property="Background" Value="#16351F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="error">
                                                        <Setter Property="Background" Value="#3A1C1C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="sys">
                                                        <Setter Property="Background" Value="#1E2730" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Ellipse Width="32" Height="32"
                                                     DockPanel.Dock="Left"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Top"
                                                     Stroke="#2F3942"
                                                     StrokeThickness="1">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowAvatar}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Time}"
                                                               Style="{StaticResource MutedText}"
                                                               HorizontalAlignment="Right" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="发送对象 wxid / 群 ID" />
                                <ComboBox x:Name="TargetBox"
                                          IsEditable="True"
                                          Text="filehelper" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelText}" Text="类型" />
                                <ComboBox x:Name="SendTypeBox" SelectedIndex="0">
                                    <ComboBoxItem Content="文本" />
                                    <ComboBoxItem Content="图片" />
                                    <ComboBoxItem Content="文件" />
                                    <ComboBoxItem Content="拍一拍" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource LabelText}" Text="群聊" />
                                <ComboBox x:Name="RoomBox"
                                          DisplayMemberPath="Display"
                                          SelectionChanged="RoomBox_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SendContentBox"
                                     MinHeight="44"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="2"
                                    x:Name="SendButton"
                                    Content="发送"
                                    MinWidth="96"
                                    Click="SendButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
